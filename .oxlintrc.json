{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-hooks",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/routeTree.gen.ts",
    "**/generated/**",
    "**/.output/**",
    "**/.tanstack/**",
    "packages/ds-contract/src/openapi.ts"
  ],
  "rules": {
    "typescript/no-explicit-any": "error"
  }
}
